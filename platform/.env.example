# Moss semantic recall — https://moss.dev
#
# Copy to platform/.env and fill in your own project credentials:
#     cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# Without these the platform runs exactly as before, regex-only.

MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# ── optional tuning ──────────────────────────────────────────────────────────
# MOSS_INDEX_NAME=remitguard-recoupment-phrases
# MOSS_SCORE_THRESHOLD=0.45   # min score for a semantic flag; raise for precision
# MOSS_ALPHA=0.6              # hybrid weight: 1.0 pure semantic, 0.0 pure keyword
# MOSS_TOP_K=3
# MOSS_CACHE_PATH=/tmp/moss-index   # persist the index across restarts
# MOSS_DISABLED=1             # force the regex-only path
